<Window x:Class="Cineleaf.Windows.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ExportTitle}" Width="460" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource ExportTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <StackPanel Grid.Row="1">
      <TextBlock Text="{DynamicResource File}"/><DockPanel Margin="0,5,0,13"><Button DockPanel.Dock="Right" Content="…" Click="Browse_Click"/><TextBox x:Name="PathBox"/></DockPanel>
      <TextBlock Text="{DynamicResource Resolution}"/><ComboBox x:Name="ResolutionBox" SelectedIndex="1" Margin="0,5,0,13"><ComboBoxItem Tag="P720">720p</ComboBoxItem><ComboBoxItem Tag="P1080">1080p</ComboBoxItem><ComboBoxItem Tag="P1440">1440p</ComboBoxItem><ComboBoxItem Tag="P2160">4K</ComboBoxItem></ComboBox>
      <TextBlock Text="{DynamicResource Codec}"/><ComboBox x:Name="CodecBox" SelectedIndex="0" Margin="0,5,0,13"><ComboBoxItem Tag="H264">H.264 — MP4</ComboBoxItem><ComboBoxItem Tag="Hevc">HEVC — MP4</ComboBoxItem></ComboBox>
      <TextBlock Text="{DynamicResource Quality}"/><ComboBox x:Name="QualityBox" SelectedIndex="1" Margin="0,5,0,13"><ComboBoxItem Tag="Compact" Content="{DynamicResource CompactQuality}"/><ComboBoxItem Tag="Balanced" Content="{DynamicResource BalancedQuality}"/><ComboBoxItem Tag="High" Content="{DynamicResource HighQuality}"/></ComboBox>
      <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="1" Margin="0,12"/>
      <TextBlock x:Name="ResultText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="Cancel_Click"/><Button x:Name="ExportButton" Content="{DynamicResource Export}" Background="{StaticResource AccentBrush}" Foreground="#07110C" Click="Export_Click"/></StackPanel>
  </Grid>
</Window>
